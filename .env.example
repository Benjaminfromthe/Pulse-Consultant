# Payload CMS
PAYLOAD_SECRET=pulse-consultant-super-secret-payload-key-change-in-production
DATABASE_URI=postgresql://postgres:password@localhost:5432/pulse_consultant

# Next.js
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Resend
RESEND_API_KEY=re_placeholder_replace_with_real_key
RESEND_FROM_EMAIL=enquiries@pulseconsultant.com
RESEND_TO_EMAIL=enquiries@pulseconsultant.com

# Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Cal.com
NEXT_PUBLIC_CAL_LINK=pulse-consultant/strategy-call

# WhatsApp
NEXT_PUBLIC_WHATSAPP_NUMBER=2348000000000

# Analytics (optional - leave empty to disable; both default to off)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# ─────────────────────────────────────────────────────────
# Supabase Setup
# Copy real values into .env.local (gitignored). Never commit real secrets.
# Payload stays the data layer (Path A) — NO anon/service-role keys needed.
# ─────────────────────────────────────────────────────────

# Supabase PostgreSQL
# Pooler (port 6543) for runtime serverless queries; Direct (port 5432) for migrations & seed.
# Get these: Supabase Dashboard → Project Settings → Database → Connection string.
# Append ?sslmode=require to both for SSL (Supabase requires it).
DATABASE_URL=postgresql://postgres.[project-ref]:[PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
DIRECT_URL=postgresql://postgres.[project-ref]:[PASSWORD]@aws-0-[region].pooler.supabase.com:5432/postgres?sslmode=require
# Legacy alias (same as DATABASE_URL); prefer DATABASE_URL above. The localhost default at
# the top of this file is for non-Supabase local dev — override DATABASE_URI in .env.local when
# using Supabase, or simply rely on DATABASE_URL (the adapter prefers it).
# DATABASE_URI=postgresql://postgres.[project-ref]:[PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require

# Supabase project URL (public; used for public file CDN URLs)
NEXT_PUBLIC_SUPABASE_URL=https://[project-ref].supabase.co

# Supabase Storage (S3-compatible)
# Get S3 keys: Supabase Dashboard → Settings → Storage → S3 Connection → Generate S3 keys.
S3_ENDPOINT=https://[project-ref].supabase.co/storage/v1/s3
S3_REGION=ap-southeast-1
S3_ACCESS_KEY_ID=[your-s3-access-key]
S3_SECRET_ACCESS_KEY=[your-s3-secret-key]
S3_BUCKET=media
S3_FORCE_PATH_STYLE=true

# Schema bootstrap (optional). Set to true ONLY to auto-create/sync the DB schema on next
# server start (useful if you cannot run the Payload migration CLI — e.g. on Node 24, where
# `npx payload migrate` is blocked by a tsx/undici incompatibility). Leave UNSET (or false)
# in production once migrations are in place. See SUPABASE-SETUP.md → "Node 24 fallback".
PAYLOAD_DB_PUSH=
